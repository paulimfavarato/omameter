#!/usr/bin/env bash
# Launch or focus the standalone Omameter Analytics Quickshell window.
# Runs in its own Quickshell instance so omarchy-shell pays 0 MB when closed.
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PLUGIN_DIR="$(cd "${SCRIPT_DIR}/.." && pwd)"
ANALYTICS_DIR="${PLUGIN_DIR}/analytics"

INITIAL_PROVIDER=""
INITIAL_PERIOD=""
INITIAL_TAB=""

while [[ $# -gt 0 ]]; do
  case "$1" in
    --provider)
      INITIAL_PROVIDER="${2:-}"
      shift 2
      ;;
    --period|--window)
      INITIAL_PERIOD="${2:-}"
      shift 2
      ;;
    --tab)
      INITIAL_TAB="${2:-}"
      shift 2
      ;;
    -h|--help)
      echo "Usage: omameter-analytics [--provider <id>] [--period <today|7d|30d|90d|all|since_reset:...>] [--tab <overview|quotas|settings>]"
      exit 0
      ;;
    *)
      shift
      ;;
  esac
done

if ! command -v quickshell >/dev/null 2>&1; then
  echo "omameter-analytics: quickshell not found in PATH" >&2
  exit 1
fi

apply_hyprland_float_rule() {
  command -v hyprctl >/dev/null 2>&1 || return 0
  # Hyprland 0.56+ (Omarchy Lua API): register idempotent float + center + size rule before mapping.
  hyprctl eval 'if omameter_analytics_window_rule then omameter_analytics_window_rule:set_enabled(false) end; omameter_analytics_window_rule = hl.window_rule({ match = { class = "^org\\.quickshell$", title = "^Omameter Analytics$" }, float = true, center = true, size = { 1120, 760 } })' >/dev/null 2>&1 \
    || hyprctl --batch 'keyword windowrulev2 float,class:^(org\.quickshell)$,title:^(Omameter Analytics)$; keyword windowrulev2 size 1120 760,class:^(org\.quickshell)$,title:^(Omameter Analytics)$; keyword windowrulev2 center,class:^(org\.quickshell)$,title:^(Omameter Analytics)$' >/dev/null 2>&1 \
    || true
}

focus_hyprland_window() {
  command -v hyprctl >/dev/null 2>&1 || return 0
  hyprctl eval 'hl.dsp.focus({ window = "title:^Omameter Analytics$" })' >/dev/null 2>&1 \
    || hyprctl dispatch focuswindow "title:^Omameter Analytics$" >/dev/null 2>&1 \
    || true
}

# If an Analytics window is already running for this plugin, update its filters and focus it.
if pgrep -f "quickshell.*${ANALYTICS_DIR}" >/dev/null 2>&1; then
  quickshell ipc -p "$ANALYTICS_DIR" call analytics focus \
    "${INITIAL_TAB}" "${INITIAL_PROVIDER}" "${INITIAL_PERIOD}" >/dev/null 2>&1 || true
  focus_hyprland_window
  exit 0
fi

# Register Hyprland/Omarchy floating window rule before spawning so the window maps floating & centered on frame 1.
apply_hyprland_float_rule

export OMAMETER_PLUGIN_DIR="$PLUGIN_DIR"
export OMAMETER_ANALYTICS_INITIAL_PROVIDER="$INITIAL_PROVIDER"
export OMAMETER_ANALYTICS_INITIAL_PERIOD="$INITIAL_PERIOD"
export OMAMETER_ANALYTICS_INITIAL_TAB="$INITIAL_TAB"

exec quickshell -d -n -p "$ANALYTICS_DIR"
