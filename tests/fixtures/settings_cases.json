{
  "_comment": "Shared by tests/test_settings.py and tests/test_settings.mjs: backend/settings.py and Settings.js must agree on every case. `expect` lists only the keys a case checks.",
  "normalize": [
    { "name": "empty input gives the defaults", "raw": {}, "expect": { "defaultTab": "priority", "maxBarItems": 3, "barLabelStyle": "full", "warningThreshold": 30, "criticalThreshold": 10, "refreshIntervalSec": 300, "privacyMode": false } },
    { "name": "invalid enums fall back to defaults", "raw": { "defaultTab": "bogus", "barLabelStyle": "tiny", "displayMode": "USED", "resetDisplayMode": 1, "timeFormat": null }, "expect": { "defaultTab": "priority", "barLabelStyle": "full", "displayMode": "remaining", "resetDisplayMode": "relative", "timeFormat": "auto" } },
    { "name": "valid enums are kept", "raw": { "defaultTab": "all", "barLabelStyle": "icon", "displayMode": "used", "resetDisplayMode": "absolute", "timeFormat": "24h" }, "expect": { "defaultTab": "all", "barLabelStyle": "icon", "displayMode": "used", "resetDisplayMode": "absolute", "timeFormat": "24h" } },
    { "name": "integers clamp to min and max", "raw": { "maxBarItems": 9, "refreshIntervalSec": 5 }, "expect": { "maxBarItems": 5, "refreshIntervalSec": 60 } },
    { "name": "compact style allows up to 8 bar items and clamps above 8", "raw": { "barLabelStyle": "compact", "maxBarItems": 9 }, "expect": { "barLabelStyle": "compact", "maxBarItems": 8 } },
    { "name": "icon style keeps 7 bar items", "raw": { "barLabelStyle": "icon", "maxBarItems": 7 }, "expect": { "barLabelStyle": "icon", "maxBarItems": 7 } },
    { "name": "full style clamps 8 bar items down to 5", "raw": { "barLabelStyle": "full", "maxBarItems": 8 }, "expect": { "barLabelStyle": "full", "maxBarItems": 5 } },
    { "name": "integers below min clamp up", "raw": { "maxBarItems": -3, "refreshIntervalSec": 999999 }, "expect": { "maxBarItems": 0, "refreshIntervalSec": 3600 } },
    { "name": "numeric strings and floats truncate", "raw": { "maxBarItems": "4", "refreshIntervalSec": 120.9 }, "expect": { "maxBarItems": 4, "refreshIntervalSec": 120 } },
    { "name": "garbage integers fall back", "raw": { "maxBarItems": "lots", "refreshIntervalSec": "", "warningThreshold": true }, "expect": { "maxBarItems": 3, "refreshIntervalSec": 300, "warningThreshold": 30 } },
    { "name": "non-boolean booleans fall back", "raw": { "privacyMode": "true", "burningFastPriority": 0, "notifyWarning": true }, "expect": { "privacyMode": false, "burningFastPriority": true, "notifyWarning": true } },
    { "name": "thresholds snap to the step", "raw": { "warningThreshold": 47, "criticalThreshold": 12 }, "expect": { "warningThreshold": 45, "criticalThreshold": 10 } },
    { "name": "thresholds clamp to their bounds", "raw": { "warningThreshold": 99, "criticalThreshold": 1 }, "expect": { "warningThreshold": 70, "criticalThreshold": 5 } },
    { "name": "critical too close to warning is pulled down", "raw": { "warningThreshold": 20, "criticalThreshold": 25 }, "expect": { "warningThreshold": 20, "criticalThreshold": 15 } },
    { "name": "unknown keys are dropped", "raw": { "legacyKey": 1 }, "absent": ["legacyKey"] }
  ],
  "applyPatch": [
    { "name": "plain patch", "current": {}, "patch": { "displayMode": "used" }, "expect": { "displayMode": "used", "warningThreshold": 30, "criticalThreshold": 10 } },
    { "name": "switching from compact 8 to full clamps maxBarItems to 5", "current": { "barLabelStyle": "compact", "maxBarItems": 8 }, "patch": { "barLabelStyle": "full" }, "expect": { "barLabelStyle": "full", "maxBarItems": 5 } },
    { "name": "switching from compact 7 to icon keeps 7", "current": { "barLabelStyle": "compact", "maxBarItems": 7 }, "patch": { "barLabelStyle": "icon" }, "expect": { "barLabelStyle": "icon", "maxBarItems": 7 } },
    { "name": "raising maxBarItems to 8 works when compact", "current": { "barLabelStyle": "compact", "maxBarItems": 5 }, "patch": { "maxBarItems": 8 }, "expect": { "barLabelStyle": "compact", "maxBarItems": 8 } },
    { "name": "raising critical pushes warning up", "current": { "warningThreshold": 20, "criticalThreshold": 15 }, "patch": { "criticalThreshold": 20 }, "expect": { "warningThreshold": 25, "criticalThreshold": 20 } },
    { "name": "lowering warning pushes critical down", "current": { "warningThreshold": 25, "criticalThreshold": 20 }, "patch": { "warningThreshold": 20 }, "expect": { "warningThreshold": 20, "criticalThreshold": 15 } },
    { "name": "critical at its max keeps warning when the gap is enough", "current": { "warningThreshold": 30, "criticalThreshold": 10 }, "patch": { "criticalThreshold": 25 }, "expect": { "warningThreshold": 30, "criticalThreshold": 25 } },
    { "name": "out-of-range warning clamps then pushes", "current": { "warningThreshold": 30, "criticalThreshold": 25 }, "patch": { "warningThreshold": 0 }, "expect": { "warningThreshold": 20, "criticalThreshold": 15 } },
    { "name": "both thresholds in one patch are taken together", "current": {}, "patch": { "warningThreshold": 50, "criticalThreshold": 20 }, "expect": { "warningThreshold": 50, "criticalThreshold": 20 } },
    { "name": "invalid enum in a patch falls back to the default", "current": { "displayMode": "used" }, "patch": { "displayMode": "nope" }, "expect": { "displayMode": "remaining" } },
    { "name": "unknown patch keys are ignored", "current": { "maxBarItems": 2 }, "patch": { "nope": 1 }, "expect": { "maxBarItems": 2 }, "absent": ["nope"] }
  ]
}
